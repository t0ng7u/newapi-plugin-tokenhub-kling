          "images": [{ "__fileRef": "request_file:input_reference", "encoding": "dataUrl", "maxBytes": 52428800 }],
          "upload": { "__fileRef": "request_file:input_reference", "encoding": "dataUrl", "maxBytes": 52428800 },
          "seconds": 5
        }
      }
    },
